generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String         @id @default(uuid()) @db.Uuid
  email                          String         @unique
  passwordHash                   String?        @map("password_hash")
  fullName                       String         @map("full_name")
  phone                          String?        @unique
  role                           UserRole       @default(STUDENT)
  status                         UserStatus     @default(PENDING_EMAIL_VERIFICATION)
  emailVerificationTokenHash     String?        @map("email_verification_token_hash")
  emailVerificationTokenExpiresAt DateTime?     @map("email_verification_token_expires_at") @db.Timestamptz(6)
  passwordResetTokenHash         String?        @map("password_reset_token_hash")
  passwordResetTokenExpiresAt    DateTime?      @map("password_reset_token_expires_at") @db.Timestamptz(6)
  emailVerifiedAt                DateTime?      @map("email_verified_at") @db.Timestamptz(6)
  createdAt                      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  refreshTokens                  RefreshToken[]
  tutorProfile                   TutorProfile?
  uploadedTutorDocuments         TutorDocument[] @relation("TutorDocumentUploader")
  reviewedTutorDocuments         TutorDocument[] @relation("TutorDocumentReviewer")
  adminAuditLogs                 AdminAuditLog[] @relation("AdminAuditActor")
  studentBookings                Booking[]      @relation("StudentBookings")
  payerPayments                  Payment[]      @relation("PaymentPayer")
  studentReviews                 Review[]       @relation("ReviewStudent")
  conversationParticipants       ConversationParticipant[]
  sentMessages                   Message[]      @relation("MessageSender")
  messageDeletions               MessageDeletion[]
  notifications                  Notification[]
  openedDisputes                 Dispute[]      @relation("DisputeOpenedBy")
  resolvedDisputes               Dispute[]      @relation("DisputeResolvedBy")

  @@index([passwordResetTokenHash])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model TutorProfile {
  id                       String                  @id @default(uuid()) @db.Uuid
  userId                   String                  @unique @map("user_id") @db.Uuid
  headline                 String?
  bio                      String?
  avatarUrl                String?                 @map("avatar_url")
  introVideoUrl            String?                 @map("intro_video_url")
  experienceYears          Int?                    @map("experience_years")
  hourlyRate               Decimal?                @map("hourly_rate") @db.Decimal(12, 2)
  teachingMode             TeachingMode            @default(BOTH) @map("teaching_mode")
  locationCity             String?                 @map("location_city")
  locationDistrict         String?                 @map("location_district")
  verificationStatus       TutorVerificationStatus @default(DRAFT) @map("verification_status")
  verificationSubmittedAt  DateTime?               @map("verification_submitted_at") @db.Timestamptz(6)
  approvedAt               DateTime?               @map("approved_at") @db.Timestamptz(6)
  rejectedAt               DateTime?               @map("rejected_at") @db.Timestamptz(6)
  rejectionReason          String?                 @map("rejection_reason")
  ratingAvg                Decimal                 @default(0) @map("rating_avg") @db.Decimal(3, 2)
  totalSessions            Int                     @default(0) @map("total_sessions")
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?               @map("deleted_at") @db.Timestamptz(6)
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects                 TutorSubject[]
  documents                TutorDocument[]
  availabilitySlots        AvailabilitySlot[]
  bookings                 Booking[]
  reviews                  Review[]
  wallet                   TutorWallet?
  withdrawals              Withdrawal[]

  @@index([verificationStatus])
  @@index([locationCity, locationDistrict])
  @@map("tutor_profiles")
}

model Subject {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  slug          String         @unique
  category      String?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  tutorSubjects TutorSubject[]

  @@map("subjects")
}

model TutorSubject {
  id             String        @id @default(uuid()) @db.Uuid
  tutorProfileId String        @map("tutor_profile_id") @db.Uuid
  subjectId      String        @map("subject_id") @db.Uuid
  level          SubjectLevel  @default(BASIC)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tutorProfile   TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([tutorProfileId, subjectId, level])
  @@index([subjectId])
  @@map("tutor_subjects")
}

model TutorDocument {
  id              String              @id @default(uuid()) @db.Uuid
  tutorProfileId  String              @map("tutor_profile_id") @db.Uuid
  uploadedById    String              @map("uploaded_by_id") @db.Uuid
  reviewedById    String?             @map("reviewed_by_id") @db.Uuid
  type            TutorDocumentType
  status          TutorDocumentStatus @default(PENDING)
  fileName        String              @map("file_name")
  filePath        String              @map("file_path")
  mimeType        String              @map("mime_type")
  fileSizeBytes   Int                 @map("file_size_bytes")
  rejectionReason String?             @map("rejection_reason")
  reviewedAt      DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tutorProfile    TutorProfile        @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  uploadedBy      User                @relation("TutorDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy      User?               @relation("TutorDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tutorProfileId])
  @@index([status])
  @@index([type])
  @@map("tutor_documents")
}

model AvailabilitySlot {
  id             String       @id @default(uuid()) @db.Uuid
  tutorProfileId String       @map("tutor_profile_id") @db.Uuid
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(6)
  isBooked       Boolean      @default(false) @map("is_booked")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  booking        Booking?

  @@index([tutorProfileId, startsAt])
  @@index([startsAt, endsAt])
  @@map("availability_slots")
}

model Booking {
  id                 String          @id @default(uuid()) @db.Uuid
  studentId          String          @map("student_id") @db.Uuid
  tutorProfileId     String          @map("tutor_profile_id") @db.Uuid
  availabilitySlotId String          @unique @map("availability_slot_id") @db.Uuid
  startsAt           DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime        @map("ends_at") @db.Timestamptz(6)
  hourlyRateSnapshot Decimal         @default(0) @map("hourly_rate_snapshot") @db.Decimal(12, 2)
  grossAmountSnapshot Decimal        @default(0) @map("gross_amount_snapshot") @db.Decimal(12, 2)
  teachingMode        TeachingMode   @default(ONLINE) @map("teaching_mode")
  status             BookingStatus   @default(PENDING)
  studentNote        String?         @map("student_note")
  cancellationReason String?         @map("cancellation_reason")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  student            User            @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Restrict)
  tutorProfile       TutorProfile    @relation(fields: [tutorProfileId], references: [id], onDelete: Restrict)
  availabilitySlot   AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  payment            Payment?
  conversation       Conversation?
  review             Review?
  disputes           Dispute[]

  @@index([studentId, startsAt])
  @@index([tutorProfileId, startsAt])
  @@index([status])
  @@map("bookings")
}

model Review {
  id             String       @id @default(uuid()) @db.Uuid
  bookingId      String       @unique @map("booking_id") @db.Uuid
  studentId      String       @map("student_id") @db.Uuid
  tutorProfileId String       @map("tutor_profile_id") @db.Uuid
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  student        User         @relation("ReviewStudent", fields: [studentId], references: [id], onDelete: Restrict)
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tutorProfileId, createdAt])
  @@map("reviews")
}

model TutorWallet {
  id               String       @id @default(uuid()) @db.Uuid
  tutorProfileId   String       @unique @map("tutor_profile_id") @db.Uuid
  availableBalance Decimal      @default(0) @map("available_balance") @db.Decimal(12, 2)
  withdrawnBalance Decimal      @default(0) @map("withdrawn_balance") @db.Decimal(12, 2)
  currency         String       @default("VND")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tutorProfile     TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  withdrawals      Withdrawal[]

  @@map("tutor_wallets")
}

model Withdrawal {
  id                String           @id @default(uuid()) @db.Uuid
  walletId          String           @map("wallet_id") @db.Uuid
  tutorProfileId    String           @map("tutor_profile_id") @db.Uuid
  amount            Decimal          @db.Decimal(12, 2)
  currency          String           @default("VND")
  status            WithdrawalStatus @default(PENDING)
  bankName          String           @map("bank_name")
  bankAccountNumber String           @map("bank_account_number")
  bankAccountName   String           @map("bank_account_name")
  requestedAt       DateTime         @default(now()) @map("requested_at") @db.Timestamptz(6)
  processedAt       DateTime?        @map("processed_at") @db.Timestamptz(6)
  rejectionReason   String?          @map("rejection_reason")
  wallet            TutorWallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  tutorProfile      TutorProfile     @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([tutorProfileId, requestedAt])
  @@index([status])
  @@map("withdrawals")
}

model Payment {
  id                 String          @id @default(uuid()) @db.Uuid
  bookingId          String          @unique @map("booking_id") @db.Uuid
  payerId            String          @map("payer_id") @db.Uuid
  amount             Decimal         @db.Decimal(12, 2)
  platformFeeAmount  Decimal         @default(0) @map("platform_fee_amount") @db.Decimal(12, 2)
  tutorPayoutAmount  Decimal         @default(0) @map("tutor_payout_amount") @db.Decimal(12, 2)
  currency           String          @default("VND")
  provider           PaymentProvider @default(MOCK)
  status             PaymentStatus   @default(PENDING)
  payoutStatus       PayoutStatus    @default(HELD) @map("payout_status")
  checkoutUrl        String?         @map("checkout_url")
  providerTxnRef     String?         @map("provider_txn_ref")
  paidAt             DateTime?       @map("paid_at") @db.Timestamptz(6)
  refundedAt         DateTime?       @map("refunded_at") @db.Timestamptz(6)
  refundReason       String?         @map("refund_reason")
  revenueReleasedAt  DateTime?       @map("revenue_released_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking            Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payer              User            @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)
  disputes           Dispute[]

  @@index([payerId])
  @@index([status])
  @@map("payments")
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  bookingId    String?                   @unique @map("booking_id") @db.Uuid
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking      Booking?                  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  lastReadAt     DateTime?    @map("last_read_at") @db.Timestamptz(6)
  hiddenAt       DateTime?    @map("hidden_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  deletions      MessageDeletion[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model MessageDeletion {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  deletedAt DateTime @default(now()) @map("deleted_at") @db.Timestamptz(6)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_deletions")
}

model AdminAuditLog {
  id           String           @id @default(uuid()) @db.Uuid
  actorId      String           @map("actor_id") @db.Uuid
  action       AdminAuditAction
  resourceType String           @map("resource_type")
  resourceId   String           @map("resource_id") @db.Uuid
  reason       String?
  metadata     Json?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User             @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@map("admin_audit_logs")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  body       String
  actionUrl  String?          @map("action_url")
  readAt     DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type])
  @@map("notifications")
}

model Dispute {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String        @map("booking_id") @db.Uuid
  paymentId     String        @map("payment_id") @db.Uuid
  openedById    String        @map("opened_by_id") @db.Uuid
  resolvedById  String?       @map("resolved_by_id") @db.Uuid
  status        DisputeStatus @default(OPEN)
  reason        String
  adminNote     String?       @map("admin_note")
  resolution    String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt    DateTime?     @map("resolved_at") @db.Timestamptz(6)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  openedBy      User          @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy    User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([paymentId])
  @@index([openedById])
  @@index([status, createdAt])
  @@map("disputes")
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum TutorVerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TeachingMode {
  ONLINE
  OFFLINE
  BOTH
}

enum SubjectLevel {
  PRIMARY
  LOWER_SECONDARY
  HIGH_SCHOOL
  UNIVERSITY
  BASIC
  INTERMEDIATE
  ADVANCED
  EXAM_PREP
}

enum TutorDocumentType {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  DEGREE
  CERTIFICATE
  BACKGROUND_CHECK
  OTHER
}

enum TutorDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentProvider {
  MOCK
  VNPAY
  MOMO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  HELD
  RELEASED
  CANCELLED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_CONFIRMED
  PAYMENT_PAID
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  WITHDRAWAL_UPDATED
  DISPUTE_UPDATED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  REJECTED
}

enum AdminAuditAction {
  TUTOR_APPROVED
  TUTOR_REJECTED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  USER_SUSPENDED
  USER_UNSUSPENDED
  PAYMENT_REFUNDED
  WITHDRAWAL_PROCESSING
  WITHDRAWAL_PAID
  WITHDRAWAL_REJECTED
  DISPUTE_UNDER_REVIEW
  DISPUTE_RESOLVED_REFUNDED
  DISPUTE_REJECTED
}
