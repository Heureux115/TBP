NODE_ENV=development
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Supabase Postgres connection string.
# Recommended for development without Docker: use the Supabase Session Pooler URI.
# Example:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=public"
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<supabase-host>:5432/postgres?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Resend email delivery. Use your own verified sender in staging/production.
# For local development only, set EMAIL_DEV_MODE="true" to print OTP codes in the API terminal.
EMAIL_DEV_MODE="true"
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="TutorConnect <no-reply@example.com>"

# One manual admin account for MVP operations.
# This account uses /auth/login and is redirected to /admin/dashboard.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_FULL_NAME="System Admin"
ADMIN_PHONE=""
